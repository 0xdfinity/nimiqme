# Copy to .env and fill in what you need. Every value is optional for local development.

# Nimiq address that receives payments on mainnet. Leave empty to keep mainnet checkout blocked.
VITE_STORE_ADDRESS=

# Per-merchant receiving addresses. These override the defaults in src/catalog.ts.
VITE_MERCHANT_ADDRESS_NORTHLINE=
VITE_MERCHANT_ADDRESS_ATLAS_SUPPLY=
VITE_MERCHANT_ADDRESS_KITE_HOME=
VITE_MERCHANT_ADDRESS_FOUNDRY_AUDIO=
VITE_MERCHANT_ADDRESS_LEDGER_DESK=

# Model gateway (server/brain.mjs). The mini app never holds a model key.
# Leave the keys empty to run on the local rule engine alone.
GROQ_API_KEY=
GROQ_MODEL=
NVIDIA_API_KEY=
NEMOTRON_MODEL=
BRAIN_PORT=8797
# Comma-separated browser origins allowed to call the gateway. Empty means none.
BRAIN_CORS=
# Where the built mini app points for the gateway. Holds no key.
VITE_BRAIN_URL=
